# Variables Portainer substitutes at deploy time.
# Real values live in the Portainer stack environment - do not commit them.

# Host IP the game ports are published on.
BIND_IP=10.77.111.10

# Server list MOTD. Same wording as mc-charlescraft.
MOTD=Bedrock and Java Minecraft, survival multiplayer

# peaceful / easy / normal / hard
DIFFICULTY=normal

# World name.
LEVEL=world

# Chunk load distances (tuned for 4 vCPU / 8 GB heap).
VIEW_DISTANCE=10
SIMULATION_DISTANCE=6

# RCON password for remote console access (not published to the network).
# Generated per deployment; recorded in the Portainer stack environment.
RCON_PASSWORD=<set>

# Names (Java profile names) to seed into the whitelist. Existing entries are
# preserved - see EXISTING_WHITELIST_FILE=MERGE in the compose file.
# Bedrock gamertags are added at runtime with scripts/mc-whitelist.sh because
# Floodgate resolves them via the GeyserMC API, not by name.
WHITELIST=

# The owner's Java + Bedrock identities are seeded from git instead
# (whitelist-seed.json / ops-seed.json, merged by config-init on every start).
# That way a rebuilt or lost volume can never lock the owner out, and both
# editions are approved without needing a name lookup at boot.
# Add other long-term members there rather than in the WHITELIST var.
